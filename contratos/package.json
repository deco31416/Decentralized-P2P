{
  "name": "cambiacripto-contracts",
  "version": "2.3.0",
  "description": "Experimental Solidity contracts and Hardhat tooling for CambiaCripto. Not audited.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "deploy:core:testnet": "hardhat run scripts/deploy/01-deploy-core.js --network bsctestnet",
    "deploy:exchange:testnet": "hardhat run scripts/deploy/02-deploy-exchange.js --network bsctestnet",
    "deploy:bridges:testnet": "hardhat run scripts/deploy/03-deploy-bridges.js --network bsctestnet",
    "deploy:managers:testnet": "hardhat run scripts/deploy/04-deploy-managers.js --network bsctestnet",
    "deploy:governance:testnet": "hardhat run scripts/deploy/05-deploy-governance.js --network bsctestnet",
    "deploy:features:testnet": "hardhat run scripts/deploy/06-deploy-features.js --network bsctestnet",
    "deploy:rewards:testnet": "hardhat run scripts/deploy/07-deploy-rewards.js --network bsctestnet",
    "deploy:all:testnet": "hardhat run scripts/deploy/deploy-all.js --network bsctestnet",
    "deploy:core:mainnet": "hardhat run scripts/deploy/01-deploy-core.js --network bscmainnet",
    "deploy:exchange:mainnet": "hardhat run scripts/deploy/02-deploy-exchange.js --network bscmainnet",
    "deploy:bridges:mainnet": "hardhat run scripts/deploy/03-deploy-bridges.js --network bscmainnet",
    "deploy:managers:mainnet": "hardhat run scripts/deploy/04-deploy-managers.js --network bscmainnet",
    "deploy:governance:mainnet": "hardhat run scripts/deploy/05-deploy-governance.js --network bscmainnet",
    "deploy:features:mainnet": "hardhat run scripts/deploy/06-deploy-features.js --network bscmainnet",
    "deploy:rewards:mainnet": "hardhat run scripts/deploy/07-deploy-rewards.js --network bscmainnet",
    "deploy:all:mainnet": "hardhat run scripts/deploy/deploy-all.js --network bscmainnet",
    "verify:testnet": "hardhat run scripts/verify/verify-all.js --network bsctestnet",
    "verify:mainnet": "hardhat run scripts/verify/verify-all.js --network bscmainnet",
    "size": "hardhat size-contracts",
    "format": "prettier --write 'contracts/**/*.sol'",
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix"
  },
  "keywords": [
    "solidity",
    "ethereum",
    "smart-contracts",
    "binance-smart-chain",
    "defi",
    "p2p",
    "exchange",
    "staking",
    "ido"
  ],
  "author": "deoc31416",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.10",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "hardhat": "^2.19.0",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.9",
    "prettier": "^3.1.0",
    "prettier-plugin-solidity": "^1.2.0",
    "solhint": "^4.0.0",
    "solidity-coverage": "^0.8.5",
    "typechain": "^8.3.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
